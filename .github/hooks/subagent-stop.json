{
  "version": 1,
  "hooks": {
    "subagentStop": [
      {
        "type": "command",
        "powershell": "pwsh -NoProfile -File \"$HOME/.agents/tools/subagent-stop-hook.ps1\"",
        "bash": "pwsh -NoProfile -File \"$HOME/.agents/tools/subagent-stop-hook.ps1\" || powershell -NoProfile -File \"$HOME/.agents/tools/subagent-stop-hook.ps1\"",
        "timeoutSec": 15
      }
    ]
  }
}
