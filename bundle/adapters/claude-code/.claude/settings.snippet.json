{
  "_comment": "Hook config for the Caspar Bannink Agentic Coding Kit. Includes both lifecycle hooks (SessionStart/End/SubagentStop/PreCompact) AND PreToolUse/PostToolUse enforcement hooks (bash dispatcher, write gateguard, task orchestrator gate, verify-mark). Pattern from affaan-m/everything-claude-code + disler/claude-code-hooks-mastery -- protocol-layer enforcement that fires deterministically. Universal opt-out via KIT_DISABLED_HOOKS env var (comma-separated rule names). All hooks route through ~/.agents/tools/_run-ps.sh which picks pwsh or powershell.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/session-start-hook.ps1 -SessionId \"${CLAUDE_SESSION_ID}\" -Mode \"${CLAUDE_MODE:-build}\" -RepoRoot \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/session-end-hook.ps1 -SessionId \"${CLAUDE_SESSION_ID}\" -Outcome \"session-end\""
          },
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/post-session.ps1 -SessionId \"${CLAUDE_SESSION_ID}\" -NonInteractive -AutoApprove"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/subagent-stop-hook.ps1 -SessionId \"${CLAUDE_SESSION_ID}\" -AgentName \"${CLAUDE_SUBAGENT_NAME}\" -Status \"${CLAUDE_SUBAGENT_STATUS:-completed}\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/precompact-hook.ps1 -SessionId \"${CLAUDE_SESSION_ID}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/hooks/pretool-bash-dispatcher.ps1"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/hooks/pretool-write-gateguard.ps1"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/hooks/pretool-task-orchestrator-gate.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tools/_run-ps.sh ~/.agents/tools/hooks/posttool-bash-verify-mark.ps1"
          }
        ]
      }
    ]
  }
}
